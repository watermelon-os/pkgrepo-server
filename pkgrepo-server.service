[Unit]
Description=HTTP-сервер управления репозиториями системных пакетных менеджеров
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sysconfig/pkgrepo-server
ExecStart=/usr/bin/env pkgrepo-server
Restart=on-failure

[Install]
WantedBy=multi-user.target