# Host address for the HTTP server.
# 0.0.0.0 - listen on all network interfaces.
SERVER_HOST=

# TCP port for the HTTP server.
SERVER_PORT=34817

# Absolute or relative path to the SQLite database file.
# Required - there is no default value.
DATABASE_PATH=/var/lib/watermelon-server/watermelon.db

# Minimum log level.
# Allowed: debug, info, warn, error.
LOG_LEVEL=

# Standard log fields whose keys should be displayed.
# Comma-separated list: time, level, logger, msg.
# Empty - keys are hidden, values are displayed only.
LOG_STANDARD_FIELDS=

# Root directory containing package repositories.
# Required - there is no default value. Must exist before the server starts.
# Repository paths from POST /api/repos are resolved relative to this directory.
REPO_ROOT=/srv/repo

# Use package-manager utilities to inspect artifact metadata.
# true  - use available utilities first, with filename parsing as fallback.
# false - use filename parsing only.
#
# RPM: rpm -qp
# DEB: dpkg-deb -f, then dpkg --info
# Pacman: tar-based metadata extraction
#
# This option affects artifact inspection only.
# It does not disable repository index updates.
USE_PACKAGE_UTILITIES=true

# Interval between background filesystem synchronization runs, in seconds.
# 0 - disable background synchronization.
SYNC_INTERVAL_SECONDS=300

# Authentication tokens in JSON format.
# Each token is an object with: value, comment, role.
# Example:
# [{"value":"...", "comment":"server admin", "role":"admin"}]
# Empty - authentication is disabled.
TOKENS=