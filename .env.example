SERVER_HOST=0.0.0.0
SERVER_PORT=3000
DATABASE_PATH=data/watermelon.db
LOG_LEVEL=info
# Стандартные поля лога, у которых показывать ключ (time, level, logger, msg),
# через запятую. По умолчанию пусто — ключи скрыты, но значения выводятся
# (например: 2026-08-16T... INFO watermelon-server-ts hello).
LOG_STANDARD_FIELDS=
# Корневой каталог репозиториев (подготовленный, обязан существовать).
# Пустой — авто-создание/инициализация выключены (пути требуются заранее).
# При заданном — пути из POST /api/repos трактуются относительно корня,
# отсутствующие каталоги/маркеры формата сервер создаёт сам.
REPO_ROOT=
# Разбор артефактов утилитами пакетной системы (rpm -qp, dpkg-deb -f, ...);
# иначе/при недоступности — фолбэк на парсер имени файла по шаблону
USE_PACKAGE_UTILITIES=true
# Период фоновой синхронизации с фс, секунды (0 — выключить)
SYNC_INTERVAL_SECONDS=300
# Авторизация по токенам (AUTH-01..04). JSON-массив объектов
# {"value": "...", "comment": "назначение", "role": "роль"}.
# Пусто/не задано — авторизация выключена.
# Токен в url колбэка для раннеров берётся из токена с ролью "runner".
TOKENS=[{"value":"secret","comment":"server admin","role":"admin"}]
